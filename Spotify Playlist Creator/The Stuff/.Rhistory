if (num_loops_artist_albums > 1){
artist_albums <- map_df(1:num_loops_artist_albums, function(this_loop){
get_artist_albums(id=id,c("album","single"),offset=(this_loop-1)*20,authorization=authorization)})
} else {
artist_albums <- artist_albums$items
}
artist_albums <- dedupe_album_names(df = artist_albums)
album_tracks <- map_df(artist_albums$id, function(this_album_id) {
album_tracks <- get_album_tracks(this_album_id,include_meta_info=TRUE,authorization=authorization)
num_loops_album_tracks <- ceiling(album_tracks$total / 20)
if (num_loops_album_tracks > 1) {
album_tracks <- map_df(1:num_loops_album_tracks, function(this_loop) {
get_album_tracks(this_album_id,offset = (this_loop - 1) * 20,authorization = authorization)})
} else {
album_tracks <- album_tracks$items
}})
newArtists <- data.frame(Artist=unlist(as.list(apply(album_tracks,1,artistNames))),
Id=unlist(as.list(apply(album_tracks,1,artistIds)))) %>%
distinct() %>%
add_column(Popularity=NA, Collaborators=NA, Date=NA)
}
#Deal with Artists that have no albums
#They might have singles
for (i in 1:5){
catalog <- read_csv("Data/Catalog.csv", col_types = cols())
newArtistId <- catalog$Id[which(is.na(catalog$Collaborators))][1]
collaborators <- nextCatalogArtist(newArtistId)
if (is.null(collaborators)){
catalog[catalog$Id == newArtistId, "Collaborators"] = 0
write_csv(catalog, "Data/Catalog.csv")
next
}
catalog[catalog$Id == newArtistId, "Collaborators"] = nrow(collaborators) - 1
rbind(catalog, collaborators) %>%
distinct_at(vars(Artist, Id), .keep_all=TRUE) %>%
write_csv("Data/Catalog.csv")
}
