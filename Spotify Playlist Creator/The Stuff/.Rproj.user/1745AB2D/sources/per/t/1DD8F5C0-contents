for (i in 1:820){
  catalog <- read_csv("Data/Catalog.csv", col_types = cols())
  newArtistId <- catalog$Id[which(is.na(catalog$Collaborators))][1]
  collaborators <- nextCatalogArtist(newArtistId)
  if (is.null(collaborators)){
    catalog[catalog$Id == newArtistId, "Collaborators"] = 0
    write_csv(catalog, "Data/Catalog.csv")
    next
  }
  catalog[catalog$Id == newArtistId, "Collaborators"] = nrow(collaborators) - 1
  rbind(catalog, collaborators) %>% 
    distinct_at(vars(Artist, Id), .keep_all=TRUE) %>% 
    write_csv("Data/Catalog.csv")
}
