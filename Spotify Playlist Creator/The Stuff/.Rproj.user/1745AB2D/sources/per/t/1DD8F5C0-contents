```{r}
for (i in 1:5){
  tryCatch({
    catalog <- read_csv("Data/Catalog.csv") # Read in the catalog
    newArtist <- catalog$Artist[which(is.na(catalog$Date))][1] # Get artist who hasn't been created
    if (is.na(newArtist)){
      deleteNA(catalog)
      next
    }
    
    features <- get_artist_audio_features(artist=newArtist, include_groups = c("album", "single")) # Grab all audio features
    cleaned <- cleanFeatures(features) # Get cleaned data

    artists <- data.frame(Artist=unique(unlist(str_split(cleaned$artists, "\\|\\|")))) %>% 
      add_column(Date=NA) # Get new list of artists
    newCatalog <- rbind(catalog, artists) %>% 
      distinct_at(vars(Artist), .keep_all=TRUE) # Add new artists to old artists list
    if (nrow(newCatalog[newCatalog$Artist == newArtist, "Date"]) > 1) {
      newCatalog <- newCatalog[-which(is.na(newCatalog$Artist)),]
    }
    newCatalog[newCatalog$Artist == newArtist, "Date"] = lubridate::today("") # Update the current Artists as done
  
    write_csv(cleaned, "Data/Tracks.csv", append=TRUE) # Append cleaned data to Tracks.csv
    write_csv(newCatalog, "Data/Catalog.csv")
  }, error = function(e){
    deleteNewArtist(newArtist, catalog)
  }
  )
}
```

